# Порт на хосте, который слушает приложение (за nginx).
APP_PORT=8001

# База данных. По умолчанию — файловый SQLite в томе контейнера.
# Строку можно не менять; если однажды понадобится внешний PostgreSQL,
# укажите его здесь (postgresql://user:pass@host:5432/dbname).
DATABASE_URL=sqlite:///./data/pricetracker.db
